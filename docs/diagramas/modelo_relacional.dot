digraph MER {
graph [rankdir=TB, fontname="Liberation Sans", nodesep=0.4, ranksep=0.45, splines=spline, pad=0.3, dpi=200];
node [shape=plain, fontname="Liberation Sans", fontsize=15];
edge [dir=both, color="#333333", penwidth=1.3, arrowsize=1.1];
equipo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1b2a5a"><TR><TD COLSPAN="3" BGCOLOR="#1b2a5a"><FONT COLOR="white"><B>equipo</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_equipo_l"><B>id_equipo</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_equipo_r"><FONT COLOR="#b3121f">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_host_l">nombre_host</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="nombre_host_r"><FONT COLOR="#b3121f">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sistema_operativo_l">sistema_operativo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="sistema_operativo_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="version_so_l">version_so</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="version_so_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nucleos_cpu_l">nucleos_cpu</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="nucleos_cpu_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ram_total_mb_l">ram_total_mb</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="ram_total_mb_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="disco_total_gb_l">disco_total_gb</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">REAL</FONT></TD><TD ALIGN="LEFT" PORT="disco_total_gb_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_registro_l">fecha_registro</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="fecha_registro_r"><FONT COLOR="#b3121f"> </FONT></TD></TR></TABLE>>];
umbral [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1b2a5a"><TR><TD COLSPAN="3" BGCOLOR="#1b2a5a"><FONT COLOR="white"><B>umbral</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_umbral_l"><B>id_umbral</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_umbral_r"><FONT COLOR="#b3121f">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_equipo_l">id_equipo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_equipo_r"><FONT COLOR="#b3121f">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="recurso_l">recurso</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="recurso_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="valor_limite_l">valor_limite</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">REAL</FONT></TD><TD ALIGN="LEFT" PORT="valor_limite_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="duracion_seg_l">duracion_seg</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="duracion_seg_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activo_l">activo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="activo_r"><FONT COLOR="#b3121f"> </FONT></TD></TR></TABLE>>];
muestra [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1b2a5a"><TR><TD COLSPAN="3" BGCOLOR="#1b2a5a"><FONT COLOR="white"><B>muestra</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_muestra_l"><B>id_muestra</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_muestra_r"><FONT COLOR="#b3121f">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_equipo_l">id_equipo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_equipo_r"><FONT COLOR="#b3121f">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_hora_l">fecha_hora</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="fecha_hora_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cpu_pct_l">cpu_pct</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">REAL</FONT></TD><TD ALIGN="LEFT" PORT="cpu_pct_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ram_pct_l">ram_pct</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">REAL</FONT></TD><TD ALIGN="LEFT" PORT="ram_pct_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="disco_pct_l">disco_pct</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">REAL</FONT></TD><TD ALIGN="LEFT" PORT="disco_pct_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="red_envio_kbps_l">red_envio_kbps</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">REAL</FONT></TD><TD ALIGN="LEFT" PORT="red_envio_kbps_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="red_recepcion_kbps_l">red_recepcion_kbps</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">REAL</FONT></TD><TD ALIGN="LEFT" PORT="red_recepcion_kbps_r"><FONT COLOR="#b3121f"> </FONT></TD></TR></TABLE>>];
proceso_muestra [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1b2a5a"><TR><TD COLSPAN="3" BGCOLOR="#1b2a5a"><FONT COLOR="white"><B>proceso_muestra</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_proceso_muestra_l"><B>id_proceso_muestra</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_proceso_muestra_r"><FONT COLOR="#b3121f">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_muestra_l">id_muestra</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_muestra_r"><FONT COLOR="#b3121f">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pid_l">pid</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="pid_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_l">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="nombre_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_l">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="estado_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prioridad_l">prioridad</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="prioridad_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cpu_pct_l">cpu_pct</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">REAL</FONT></TD><TD ALIGN="LEFT" PORT="cpu_pct_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="memoria_mb_l">memoria_mb</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">REAL</FONT></TD><TD ALIGN="LEFT" PORT="memoria_mb_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hilos_l">hilos</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="hilos_r"><FONT COLOR="#b3121f"> </FONT></TD></TR></TABLE>>];
alerta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1b2a5a"><TR><TD COLSPAN="3" BGCOLOR="#1b2a5a"><FONT COLOR="white"><B>alerta</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_alerta_l"><B>id_alerta</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_alerta_r"><FONT COLOR="#b3121f">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_muestra_l">id_muestra</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_muestra_r"><FONT COLOR="#b3121f">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_umbral_l">id_umbral</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_umbral_r"><FONT COLOR="#b3121f">FK (nulo)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_l">tipo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="tipo_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="severidad_l">severidad</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="severidad_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pid_l">pid</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="pid_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_proceso_l">nombre_proceso</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="nombre_proceso_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mensaje_l">mensaje</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="mensaje_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="recomendacion_l">recomendacion</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="recomendacion_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_l">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="estado_r"><FONT COLOR="#b3121f"> </FONT></TD></TR></TABLE>>];
accion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1b2a5a"><TR><TD COLSPAN="3" BGCOLOR="#1b2a5a"><FONT COLOR="white"><B>accion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_accion_l"><B>id_accion</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_accion_r"><FONT COLOR="#b3121f">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_equipo_l">id_equipo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_equipo_r"><FONT COLOR="#b3121f">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_alerta_l">id_alerta</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="id_alerta_r"><FONT COLOR="#b3121f">FK (nulo)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pid_l">pid</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="pid_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_proceso_l">nombre_proceso</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="nombre_proceso_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_l">tipo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="tipo_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="detalle_l">detalle</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="detalle_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="confirmada_l">confirmada</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD ALIGN="LEFT" PORT="confirmada_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="resultado_l">resultado</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="resultado_r"><FONT COLOR="#b3121f"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_hora_l">fecha_hora</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="fecha_hora_r"><FONT COLOR="#b3121f"> </FONT></TD></TR></TABLE>>];
equipo -> muestra [arrowtail=teetee, arrowhead=crowodot];
equipo -> umbral [arrowtail=teetee, arrowhead=crowodot];
equipo -> accion [arrowtail=teetee, arrowhead=crowodot];
muestra -> proceso_muestra [arrowtail=teetee, arrowhead=crowodot];
muestra -> alerta [arrowtail=teetee, arrowhead=crowodot];
umbral -> alerta [arrowtail=teeodot, arrowhead=crowodot];
alerta -> accion [arrowtail=teeodot, arrowhead=crowodot];
{rank=same; umbral; muestra;} {rank=same; alerta; proceso_muestra;}
}