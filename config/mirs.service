# Unidad systemd de MIRS para Linux (se instala con scripts/linux/instalar.sh).
[Unit]
Description=MIRS - Monitor Inteligente de Recursos del Sistema
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mirs
Group=mirs
WorkingDirectory=/opt/mirs
ExecStart=/opt/mirs/venv/bin/python /opt/mirs/app/mirs_servidor.py --bd /var/lib/mirs/mirs.db --sin-bluetooth
Restart=on-failure
RestartSec=5

# Endurecimiento: el servicio solo puede escribir en su carpeta de datos
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/mirs
UMask=0027

[Install]
WantedBy=multi-user.target
