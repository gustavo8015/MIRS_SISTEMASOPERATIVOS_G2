<?xml version="1.0" encoding="utf-8"?>
<!-- Pestaña Panel: chip 3D con el uso de CPU, anillos, alerta, gráfica, núcleos y procesos -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/refrescar_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="270dp">

                <com.umb.mirs.AnilloView
                    android:id="@+id/anillo_cpu"
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:layout_gravity="center" />

                <com.umb.mirs.Chip3DView
                    android:id="@+id/chip"
                    android:layout_width="210dp"
                    android:layout_height="132dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="36dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="36dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/cpu_valor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:shadowColor="#80000000"
                        android:shadowRadius="8"
                        android:text="-"
                        android:textColor="@color/texto"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/cpu_estado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.15"
                        android:text="CPU"
                        android:textColor="@color/texto_suave"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <LinearLayout style="@style/ColumnaAnillo">
                    <com.umb.mirs.AnilloView android:id="@+id/anillo_ram" style="@style/AnilloPequeno" />
                    <TextView style="@style/TituloAnillo" android:text="@string/ram" />
                    <TextView android:id="@+id/ram_detalle" style="@style/DetalleAnillo" />
                </LinearLayout>

                <LinearLayout style="@style/ColumnaAnillo">
                    <com.umb.mirs.AnilloView android:id="@+id/anillo_disco" style="@style/AnilloPequeno" />
                    <TextView style="@style/TituloAnillo" android:text="@string/disco" />
                    <TextView android:id="@+id/disco_detalle" style="@style/DetalleAnillo" />
                </LinearLayout>

                <LinearLayout style="@style/ColumnaAnillo">
                    <com.umb.mirs.AnilloView android:id="@+id/anillo_red" style="@style/AnilloPequeno" />
                    <TextView style="@style/TituloAnillo" android:text="@string/red" />
                    <TextView android:id="@+id/red_detalle" style="@style/DetalleAnillo" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/banner_alerta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/fondo_alerta"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:visibility="gone">

                <com.umb.mirs.PulsoView
                    android:id="@+id/pulso"
                    android:layout_width="44dp"
                    android:layout_height="44dp" />

                <TextView
                    android:id="@+id/texto_banner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="@color/texto_peligro"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                style="@style/TarjetaVidrio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TituloTarjeta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/uso_en_vivo" />

                    <TextView
                        android:id="@+id/leyenda"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texto_tenue"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <com.umb.mirs.GraficaLineas
                    android:id="@+id/grafica"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout
                style="@style/TarjetaVidrio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TituloTarjeta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nucleos_logicos" />

                    <TextView
                        android:id="@+id/nucleos_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texto_tenue"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <com.umb.mirs.MapaNucleosView
                    android:id="@+id/mapa_nucleos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/nucleos_aviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nucleos_aviso"
                    android:textColor="@color/texto_suave"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                style="@style/TarjetaVidrio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TituloTarjeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mayor_consumo" />

                <LinearLayout
                    android:id="@+id/lista_mayor_consumo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
